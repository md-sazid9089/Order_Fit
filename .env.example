# Host-facing web port for docker compose (copy to .env if a default port is taken)
WEB_PORT=3000
DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=
DOCUMENT_S3_ENDPOINT_URL=
DOCUMENT_S3_ACCESS_KEY_ID=
DOCUMENT_S3_SECRET_ACCESS_KEY=
DOCUMENT_S3_ADDRESSING_STYLE=auto

# Separate explicit credentials. Replace passwords with generated values of at least 32 characters.
POSTGRES_USER=orderfit_migrator
POSTGRES_PASSWORD=REPLACE_LOCALLY
POSTGRES_DB=orderfit
DATABASE_URL=postgresql+psycopg://orderfit_runtime:REPLACE_LOCALLY@db:5432/orderfit
DATABASE_URL_DIRECT=postgresql+psycopg://orderfit_migrator:REPLACE_LOCALLY@db:5432/orderfit
WORKER_DATABASE_URL=postgresql+psycopg://orderfit_worker_login:REPLACE_LOCALLY@db:5432/orderfit
# One-time setup-profile provisioning; these must match the runtime URLs above.
RUNTIME_LOGIN=orderfit_runtime
RUNTIME_PASSWORD=REPLACE_LOCALLY
WORKER_LOGIN=orderfit_worker_login
WORKER_PASSWORD=REPLACE_LOCALLY
LLM_MODE=off
LLM_RECORDINGS_DIR=
OPENAI_API_KEY=
OPENAI_MODEL=
SESSION_SECRET=
ACCOUNT_FINGERPRINT_KEY=
ACCOUNT_FINGERPRINT_KEY_VERSION=1
COOKIE_SECURE=false
# Explicit proxy trust for the API (JSON list of IPs/CIDRs); [] ignores X-Forwarded-* headers.
TRUSTED_PROXY_IPS=[]
AUTH_ACCOUNT_LIMIT=15
AUTH_SOURCE_LIMIT=300
UPLOAD_CONCURRENCY=4
UPLOAD_SOURCE_CONCURRENCY=2
UPLOAD_BODY_TIMEOUT_SECONDS=120
UPLOAD_IDLE_TIMEOUT_SECONDS=30
# Keep the interactive API schema endpoints disabled in deployed runtimes.
EXPOSE_API_DOCS=false

# ---------------------------------------------------------------------------------------------
# Hosted deployment (Vercel + Render + Neon). Variable NAMES only; set values in each platform's
# dashboard, never in a committed file. Details: docs/deployment/{render,neon,vercel}.md
#
#   Render  orderfit-api      DATABASE_URL (Neon POOLED host, login orderfit_runtime),
#                             ALLOWED_ORIGINS (JSON list of exact Vercel origins),
#                             DOCUMENT_STORAGE_BACKEND=s3, DOCUMENT_S3_BUCKET, DOCUMENT_S3_REGION,
#                             DOCUMENT_S3_ACCESS_KEY_ID, DOCUMENT_S3_SECRET_ACCESS_KEY,
#                             optional DOCUMENT_S3_ENDPOINT_URL / DOCUMENT_S3_ADDRESSING_STYLE,
#                             TRUSTED_PROXY_IPS (default [] = forwarded headers ignored),
#                             UPLOAD_BODY_TIMEOUT_SECONDS, UPLOAD_IDLE_TIMEOUT_SECONDS,
#                             EXPOSE_API_DOCS=false,
#                             and group orderfit-shared: SESSION_SECRET, ACCOUNT_FINGERPRINT_KEY,
#                             ACCOUNT_FINGERPRINT_KEY_VERSION, COOKIE_SECURE=true, LLM_MODE
#                             (optional, LLM_MODE=live only: OPENAI_API_KEY, OPENAI_MODEL)
#   Render  orderfit-worker   DATABASE_URL (Neon POOLED host, login orderfit_worker_login),
#                             ALLOWED_ORIGINS, DOCUMENT_DIR, group orderfit-shared
#                             (WORKER_DATABASE_URL is a local-launcher name only; not used on Render)
#   Render  orderfit-migrate  DATABASE_URL_DIRECT (Neon DIRECT host, migration owner) - this
#                             service only; the API and worker refuse to start if it is present
#   Vercel  web               API_INTERNAL_URL (Render API public https URL); leave
#                             NEXT_PUBLIC_API_URL unset
#   Neon    one-time operator work (not an env var of any service): RUNTIME_LOGIN, RUNTIME_PASSWORD,
#           WORKER_LOGIN, WORKER_PASSWORD are used by `python -m orderfit.store.provision` from an
#           operator shell with DATABASE_URL_DIRECT. URL scheme must be postgresql+psycopg:// and
#           the query must carry sslmode=verify-full&sslrootcert=system.
