# Copy to .env.local for local development. Never commit .env.local.
#
# How the browser reaches the API
#   Default (and Vercel): leave NEXT_PUBLIC_API_URL unset. The browser calls this app's own
#   origin at /api/v1/*, and next.config.ts proxies it to API_INTERNAL_URL. This keeps the
#   HttpOnly SameSite=Lax session cookie first-party.
#   Same-site direct mode (local only): set NEXT_PUBLIC_API_URL=http://localhost:8000.

# Server-side address of the OrderFit API (proxy target and /api/health).
# Vercel: the API's public HTTPS URL, e.g. https://api.example.com (required; the build fails without it).
# Docker Compose: the service name, http://api:8000.
API_INTERNAL_URL=http://localhost:8000

# Optional, inlined into the browser bundle at build time. Leave unset to use the proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8000
