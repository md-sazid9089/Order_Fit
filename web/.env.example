# Copy to .env.local. Never commit .env.local.

# API address as the browser sees it. Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API address for server-side code (route handlers). Optional; defaults to NEXT_PUBLIC_API_URL.
# In Docker Compose this is the service name, e.g. http://api:8000.
API_INTERNAL_URL=
