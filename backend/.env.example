# Copy to .env and fill in. Never commit .env.

# AI provider
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0

# Database: Postgres (docker compose starts one on localhost:5432)
DATABASE_URL=postgresql+psycopg://orderfit:orderfit@localhost:5432/orderfit

# Uploaded documents (local folder for the MVP; object storage at pilot)
DOCUMENT_DIR=./var/documents

# API
CORS_ORIGINS=["http://localhost:3000"]

# Engine defaults
TARGET_TOLERANCE_DAYS=15
