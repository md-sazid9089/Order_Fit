# Inject into the process explicitly. No automatic .env loading.
# Restricted API login. The worker gets a distinct orderfit_worker member login.
DATABASE_URL=postgresql+psycopg://orderfit_runtime:REPLACE_LOCALLY@localhost:5432/orderfit
# Explicit local launcher selects this URL for the worker process only.
WORKER_DATABASE_URL=postgresql+psycopg://orderfit_worker_login:REPLACE_LOCALLY@localhost:5432/orderfit
DOCUMENT_DIR=./var/documents
DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=
DOCUMENT_S3_ENDPOINT_URL=
DOCUMENT_S3_ACCESS_KEY_ID=
DOCUMENT_S3_SECRET_ACCESS_KEY=
DOCUMENT_S3_ADDRESSING_STYLE=auto
LLM_MODE=off
LLM_PROVIDER=openai
# Testing: select freellmpool and set an explicitly tested keyless provider/model.
FREELLMPOOL_MODEL=
FREELLMPOOL_STATE_DIR=./var/freellmpool
# Conservative spacing for anonymous upstream limits; advisory per worker process.
FREELLMPOOL_MIN_INTERVAL_SECONDS=35
LLM_RECORDINGS_DIR=
OPENAI_API_KEY=
OPENAI_MODEL=
SESSION_SECRET=
ACCOUNT_FINGERPRINT_KEY=
ACCOUNT_FINGERPRINT_KEY_VERSION=1
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
# JSON list of proxy IPs/CIDRs whose X-Forwarded-For is trusted. [] = ignore forwarded headers.
TRUSTED_PROXY_IPS=[]
# Auth throttles per 15 minutes: strict per account/step-up session (max 15), coarse ceiling
# per source address (shared by every user behind one proxy/edge address).
AUTH_ACCOUNT_LIMIT=15
AUTH_SOURCE_LIMIT=300
# Concurrent document uploads admitted per API process, and per source address.
UPLOAD_CONCURRENCY=4
UPLOAD_SOURCE_CONCURRENCY=2
# Overall and idle bounds for a slot-holding authorized upload body.
UPLOAD_BODY_TIMEOUT_SECONDS=120
UPLOAD_IDLE_TIMEOUT_SECONDS=30
# Interactive docs and served OpenAPI are disabled unless explicitly enabled.
EXPOSE_API_DOCS=false
# DATABASE_URL_DIRECT is injected only into the migrator; no runtime fallback.

# Hosted (Render) uses the same names, injected by the platform instead of a file. Notes:
#  - DATABASE_URL on each Render service is the Neon POOLED URL with that service's own login
#    (API: orderfit_runtime; worker: orderfit_worker_login). WORKER_DATABASE_URL is only read by
#    `python -m orderfit.runtime worker` locally.
#  - Scheme must be postgresql+psycopg:// and the URL must include sslmode=verify-full&sslrootcert=system.
#  - DATABASE_URL_DIRECT exists only on the one-shot migration service (orderfit-migrate).
#  - COOKIE_SECURE=true and ALLOWED_ORIGINS=["https://<vercel-origin>"] in production.
# See ../render.yaml and ../docs/deployment/render.md.

# Optional password + passkey MFA: exact trusted hostname and allowed origin.
# Use your HTTPS web origin in deployment; localhost is for local development only.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
