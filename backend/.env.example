# Inject into the process explicitly. No automatic .env loading.
# Restricted API login. The worker gets a distinct orderfit_worker member login.
DATABASE_URL=postgresql+psycopg://orderfit_runtime:REPLACE_LOCALLY@localhost:5432/orderfit
# Explicit local launcher selects this URL for the worker process only.
WORKER_DATABASE_URL=postgresql+psycopg://orderfit_worker_login:REPLACE_LOCALLY@localhost:5432/orderfit
DOCUMENT_DIR=./var/documents
LLM_MODE=off
OPENAI_API_KEY=
OPENAI_MODEL=
SESSION_SECRET=
ACCOUNT_FINGERPRINT_KEY=
ACCOUNT_FINGERPRINT_KEY_VERSION=1
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
# DATABASE_URL_DIRECT is injected only into the migrator; no runtime fallback.
