# Copy to .env and fill in. Never commit .env.

# AI provider
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0

# Storage (MVP: local SQLite + local folder)
DATABASE_URL=sqlite:///./var/orderfit.db
CHECKPOINT_DB_PATH=./var/checkpoints.db
DOCUMENT_DIR=./var/documents

# API
CORS_ORIGINS=http://localhost:3000

# Engine defaults
TARGET_TOLERANCE_DAYS=15
