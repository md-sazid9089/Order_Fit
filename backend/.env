# Copy to .env and fill in. Never commit .env.

# AI provider
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0

# Database: Postgres. Default is the local docker compose one on localhost:5432.
# Neon: DATABASE_URL = pooled endpoint (host has "-pooler"), DATABASE_URL_DIRECT = same
# without "-pooler" (used by Alembic). Use the postgresql+psycopg:// scheme and keep
# ?sslmode=require&channel_binding=require.
DATABASE_URL=postgresql+psycopg://neondb_owner:npg_WrNMXw5Yi1cR@ep-fragrant-credit-b5ktd81m-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=postgresql+psycopg://neondb_owner:npg_WrNMXw5Yi1cR@ep-fragrant-credit-b5ktd81m.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Uploaded documents (local folder for the MVP; object storage at pilot)
DOCUMENT_DIR=./var/documents

# API
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Engine defaults
TARGET_TOLERANCE_DAYS=15
